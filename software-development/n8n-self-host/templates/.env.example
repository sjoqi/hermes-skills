# .env.example — copy to .env and fill secrets. NEVER commit the real .env.
# Generate every value with a random generator; do NOT reuse these placeholders.

# Pin a version for clients (e.g. 2.8.4). 'stable' = latest stable, fine for learning.
N8N_VERSION=stable

# === Postgres ===
# RULE: usernames MUST be LOWERCASE-ONLY. Postgres folds unquoted identifiers to
# lowercase on create but auth is case-sensitive, so a mixed-case name (e.g.
# u189F33d0YODB7wo) is stored lowercase and n8n's verbatim send fails with
# "role does not exist". Passwords may be mixed-case (they are quoted).
# The split-user setup relies on init-data.sh to CREATE POSTGRES_NON_ROOT_USER.
POSTGRES_USER=REPLACE_LOWERCASE_RANDOM
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM
POSTGRES_DB=n8n

POSTGRES_NON_ROOT_USER=REPLACE_LOWERCASE_RANDOM
POSTGRES_NON_ROOT_PASSWORD=REPLACE_WITH_RANDOM

RUNNERS_AUTH_TOKEN=REPLACE_WITH_RANDOM

# === n8n ===
# Generate a strong key ONCE and keep it: openssl rand -base64 48
# Losing this key = cannot decrypt credentials stored in the DB.
N8N_ENCRYPTION_KEY=REPLACE_WITH_OPENSLL_RAND_BASE64_48
GENERIC_TIMEZONE=Asia/Jakarta
